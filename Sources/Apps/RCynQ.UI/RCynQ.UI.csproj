<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <BuiltInComInteropSupport>true</BuiltInComInteropSupport>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <ApplicationIcon>Assets\rcynq.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <AvaloniaResource Include="Assets\**" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" />
    <PackageReference Include="Avalonia.Desktop" />
    <PackageReference Include="Avalonia.Themes.Fluent" />
    <PackageReference Include="Avalonia.Fonts.Inter" />
    <PackageReference Include="CommunityToolkit.Mvvm" />
    <PackageReference Include="Microsoft.AspNetCore.SignalR.Client" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\Core\RCynQ.Core\RCynQ.Core.csproj" />
    <ProjectReference Include="..\..\Infrastructure\RCynQ.Ssh\RCynQ.Ssh.csproj" />
    <ProjectReference Include="..\..\Infrastructure\RCynQ.MergeTools\RCynQ.MergeTools.csproj" />
  </ItemGroup>

  <!--
    The launcher of an installation root: the same application host (with the RCynQ icon) pointing at ui\RCynQ.UI.dll,
    so the installation root holds one RCynQ.exe instead of a .cmd file. Publish with -p:RCynQRootLauncherPath=...
  -->
  <Target Name="RCynQRootLauncher" AfterTargets="Publish" DependsOnTargets="_GetAppHostPaths"
          Condition="'$(RCynQRootLauncherPath)' != '' and '$(AppHostSourcePath)' != ''">
    <CreateAppHost AppHostSourcePath="$(AppHostSourcePath)"
                   AppHostDestinationPath="$(RCynQRootLauncherPath)"
                   AppBinaryName="ui\$(AssemblyName)$(TargetExt)"
                   IntermediateAssembly="@(IntermediateAssembly->'%(FullPath)')"
                   WindowsGraphicalUserInterface="true"
                   Retries="$(CopyRetryCount)"
                   RetryDelayMilliseconds="$(CopyRetryDelayMilliseconds)" />
  </Target>

</Project>
