<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <!-- Palette of the dark RCynQ look. The application commits to a single dark theme. -->
  <Color x:Key="WindowBackgroundColor">#1B1D21</Color>
  <Color x:Key="NavBackgroundColor">#202328</Color>
  <Color x:Key="CardBackgroundColor">#22252A</Color>
  <Color x:Key="InputBackgroundColor">#25282E</Color>
  <Color x:Key="HoverBackgroundColor">#2C3036</Color>
  <Color x:Key="PressedBackgroundColor">#33373E</Color>
  <Color x:Key="DividerColor">#2F333A</Color>
  <Color x:Key="BorderColor">#3A3F47</Color>
  <Color x:Key="BorderHoverColor">#4B515A</Color>
  <Color x:Key="AccentColor">#4A8FF7</Color>
  <Color x:Key="AccentHoverColor">#62A0FA</Color>
  <Color x:Key="AccentPressedColor">#3A7BE0</Color>
  <Color x:Key="TextPrimaryColor">#E6E8EB</Color>
  <Color x:Key="TextSecondaryColor">#A0A6AE</Color>
  <Color x:Key="TextMutedColor">#737A83</Color>
  <Color x:Key="SuccessColor">#3FB950</Color>
  <Color x:Key="WarningColor">#D29922</Color>
  <Color x:Key="DangerColor">#F85149</Color>

  <SolidColorBrush x:Key="WindowBackgroundBrush" Color="{StaticResource WindowBackgroundColor}" />
  <SolidColorBrush x:Key="NavBackgroundBrush" Color="{StaticResource NavBackgroundColor}" />
  <SolidColorBrush x:Key="CardBackgroundBrush" Color="{StaticResource CardBackgroundColor}" />
  <SolidColorBrush x:Key="InputBackgroundBrush" Color="{StaticResource InputBackgroundColor}" />
  <SolidColorBrush x:Key="HoverBackgroundBrush" Color="{StaticResource HoverBackgroundColor}" />
  <SolidColorBrush x:Key="PressedBackgroundBrush" Color="{StaticResource PressedBackgroundColor}" />
  <SolidColorBrush x:Key="DividerBrush" Color="{StaticResource DividerColor}" />
  <SolidColorBrush x:Key="BorderBrush" Color="{StaticResource BorderColor}" />
  <SolidColorBrush x:Key="BorderHoverBrush" Color="{StaticResource BorderHoverColor}" />
  <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource AccentColor}" />
  <SolidColorBrush x:Key="AccentHoverBrush" Color="{StaticResource AccentHoverColor}" />
  <SolidColorBrush x:Key="AccentPressedBrush" Color="{StaticResource AccentPressedColor}" />
  <SolidColorBrush x:Key="AccentSubtleBrush" Color="{StaticResource AccentColor}" Opacity="0.14" />
  <SolidColorBrush x:Key="TextPrimaryBrush" Color="{StaticResource TextPrimaryColor}" />
  <SolidColorBrush x:Key="TextSecondaryBrush" Color="{StaticResource TextSecondaryColor}" />
  <SolidColorBrush x:Key="TextMutedBrush" Color="{StaticResource TextMutedColor}" />
  <SolidColorBrush x:Key="SuccessBrush" Color="{StaticResource SuccessColor}" />
  <SolidColorBrush x:Key="WarningBrush" Color="{StaticResource WarningColor}" />
  <SolidColorBrush x:Key="WarningSubtleBrush" Color="{StaticResource WarningColor}" Opacity="0.12" />
  <SolidColorBrush x:Key="DangerBrush" Color="{StaticResource DangerColor}" />
  <SolidColorBrush x:Key="DangerSubtleBrush" Color="{StaticResource DangerColor}" Opacity="0.12" />

  <!-- Fluent accent overrides so built-in controls (selection, focus, check marks) use the RCynQ blue. -->
  <Color x:Key="SystemAccentColor">#4A8FF7</Color>
  <Color x:Key="SystemAccentColorDark1">#3A7BE0</Color>
  <Color x:Key="SystemAccentColorDark2">#2F68C4</Color>
  <Color x:Key="SystemAccentColorDark3">#2556A6</Color>
  <Color x:Key="SystemAccentColorLight1">#62A0FA</Color>
  <Color x:Key="SystemAccentColorLight2">#7DB1FB</Color>
  <Color x:Key="SystemAccentColorLight3">#A3C8FD</Color>

  <!-- The colours of the logo (Assets/rcynq.svg): the blue bar, the violet ring and their mix. -->
  <SolidColorBrush x:Key="BrandBlueBrush" Color="#60A5FA" />
  <SolidColorBrush x:Key="BrandVioletBrush" Color="#C084FC" />
  <SolidColorBrush x:Key="BrandMixBrush" Color="#9094FB" />

  <FontFamily x:Key="MonoFont">Cascadia Mono, Consolas, JetBrains Mono, DejaVu Sans Mono, Menlo, monospace</FontFamily>
  <CornerRadius x:Key="ControlRadius">6</CornerRadius>
  <CornerRadius x:Key="CardRadius">8</CornerRadius>

</ResourceDictionary>
