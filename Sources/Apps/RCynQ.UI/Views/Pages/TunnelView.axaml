<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="using:RCynQ.UI.Localization"
             xmlns:pages="using:RCynQ.UI.ViewModels.Pages"
             xmlns:items="using:RCynQ.UI.ViewModels.Items"
             xmlns:controls="using:RCynQ.UI.Controls"
             x:Class="RCynQ.UI.Views.Pages.TunnelView"
             x:DataType="pages:TunnelViewModel">
  <ScrollViewer>
    <StackPanel Margin="28,22,28,28" Spacing="18">

      <StackPanel>
        <TextBlock Classes="section" Text="{loc:Loc Tunnel.Title}" />
        <TextBlock Classes="muted" TextWrapping="Wrap" Margin="0,-4,0,10"
                   Text="{loc:Loc Tunnel.Hint}" />
        <Border Classes="card">
          <StackPanel>
            <Border Classes="header-row">
              <Grid ColumnDefinitions="1.3*,1.4*,1.1*,110,Auto">
                <TextBlock Text="{loc:Loc Tunnel.Link}" />
                <TextBlock Grid.Column="1" Text="SSH" />
                <TextBlock Grid.Column="2" Text="{loc:Loc Tunnel.Network}" />
                <TextBlock Grid.Column="3" Text="{loc:Loc Common.Status}" />
              </Grid>
            </Border>
            <TextBlock Classes="muted" Margin="16,14" IsVisible="{Binding HasNoLinks}" Text="{loc:Loc Tunnel.NoLinks}" />
            <ItemsControl Classes="rows" ItemsSource="{Binding Links}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="items:TunnelLinkItemViewModel">
                  <Border Classes="row">
                    <Grid ColumnDefinitions="1.3*,1.4*,1.1*,110,Auto" RowDefinitions="Auto,Auto">
                      <StackPanel VerticalAlignment="Center" Spacing="2">
                        <TextBlock Text="{Binding Name}" FontWeight="Medium" TextTrimming="CharacterEllipsis" />
                        <TextBlock Classes="muted" FontSize="12" Text="{Binding PeerText}" TextTrimming="CharacterEllipsis" />
                      </StackPanel>
                      <TextBlock Grid.Column="1" Classes="mono secondary" Text="{Binding Address}" TextTrimming="CharacterEllipsis" />
                      <StackPanel Grid.Column="2" VerticalAlignment="Center" Spacing="2">
                        <TextBlock Classes="secondary" Text="{Binding ActiveTransportText}" TextTrimming="CharacterEllipsis" />
                        <TextBlock Classes="muted" FontSize="12" Text="{Binding FallbackText}" TextTrimming="CharacterEllipsis" />
                      </StackPanel>
                      <TextBlock Grid.Column="3" Classes="status"
                                 Classes.online="{Binding IsOnline}"
                                 Classes.degraded="{Binding IsDegraded}"
                                 Classes.offline="{Binding IsOffline}"
                                 Text="{Binding StatusText}"
                                 ToolTip.Tip="{Binding Message}" />
                      <StackPanel Grid.Column="4" Orientation="Horizontal" Spacing="4" IsVisible="{Binding CanToggle}">
                        <Button Classes="icon" Padding="6" ToolTip.Tip="{loc:Loc Tunnel.Up}"
                                Command="{Binding $parent[ItemsControl].((pages:TunnelViewModel)DataContext).StartCommand}"
                                CommandParameter="{Binding}">
                          <controls:IconView Classes="small" IconKey="Icon.Play" />
                        </Button>
                        <Button Classes="icon" Padding="6" ToolTip.Tip="{loc:Loc Tunnel.Down}"
                                Command="{Binding $parent[ItemsControl].((pages:TunnelViewModel)DataContext).StopCommand}"
                                CommandParameter="{Binding}">
                          <controls:IconView Classes="small" IconKey="Icon.Stop" />
                        </Button>
                      </StackPanel>
                      <!-- What the check found: where the path stops, or how the node answered. -->
                      <TextBlock Grid.Row="1" Grid.ColumnSpan="5" Classes="muted" FontSize="12" Margin="0,6,0,0"
                                 TextWrapping="Wrap" IsVisible="{Binding HasMessage}" Text="{Binding Message}" />
                    </Grid>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </Border>
      </StackPanel>

    </StackPanel>
  </ScrollViewer>
</UserControl>
