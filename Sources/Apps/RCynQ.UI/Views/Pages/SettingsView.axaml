<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="using:RCynQ.UI.Localization"
             xmlns:pages="using:RCynQ.UI.ViewModels.Pages"
             xmlns:vm="using:RCynQ.UI.ViewModels"
             xmlns:items="using:RCynQ.UI.ViewModels.Items"
             xmlns:controls="using:RCynQ.UI.Views.Controls"
             x:Class="RCynQ.UI.Views.Pages.SettingsView"
             x:DataType="pages:SettingsViewModel">
  <ScrollViewer>
    <StackPanel Margin="28,22,28,28" Spacing="18">

      <StackPanel>
        <TextBlock Classes="section" Text="{loc:Loc Settings.Title}" />
        <Border Classes="card">
          <StackPanel Margin="16,14" Spacing="10">
            <controls:LanguageSelector DataContext="{Binding Language}" HorizontalAlignment="Left" />
            <TextBlock Classes="muted" TextWrapping="Wrap" Text="{loc:Loc Settings.LanguageHint}" />
            <TextBlock Classes="danger" TextWrapping="Wrap"
                       IsVisible="{Binding Language.HasError}" Text="{Binding Language.Error}" />
            <TextBlock Classes="muted mono" FontSize="12" TextWrapping="Wrap"
                       IsVisible="{Binding HasSettingsPath}" Text="{Binding StoredInText}" />
          </StackPanel>
        </Border>
      </StackPanel>

      <!-- The merge tool conflicts are resolved in: a tool found on the machine, or one the user describes. -->
      <StackPanel IsVisible="{Binding HasMergeTool}">
        <TextBlock Classes="section" Text="{loc:Loc Settings.MergeTool.Title}" />
        <Border Classes="card">
          <StackPanel Margin="16,14" Spacing="10" DataContext="{Binding MergeTool}" x:DataType="vm:MergeToolSettingsViewModel">
            <StackPanel Orientation="Horizontal" Spacing="8">
              <ComboBox MinWidth="320" ItemsSource="{Binding Options}" SelectedItem="{Binding Selected}" IsEnabled="{Binding !IsScanning}">
                <ComboBox.ItemTemplate>
                  <DataTemplate x:DataType="items:MergeToolOptionViewModel">
                    <TextBlock Text="{Binding Name}" />
                  </DataTemplate>
                </ComboBox.ItemTemplate>
              </ComboBox>
              <Button Classes="outline" Content="{loc:Loc Settings.MergeTool.Rescan}" Command="{Binding RescanCommand}"
                      IsEnabled="{Binding !IsScanning}" />
            </StackPanel>
            <TextBlock Classes="muted mono" FontSize="12" TextWrapping="Wrap" Text="{Binding PathText}" IsVisible="{Binding !IsCustom}" />
            <TextBlock Classes="muted" TextWrapping="Wrap" Text="{loc:Loc Settings.MergeTool.Scanning}" IsVisible="{Binding IsScanning}" />
            <TextBlock Classes="muted" TextWrapping="Wrap" Text="{loc:Loc Settings.MergeTool.NoneFound}" IsVisible="{Binding HasNoTools}" />

            <!-- A tool that is not in the catalog: its executable and the template of its arguments. -->
            <StackPanel Spacing="8" IsVisible="{Binding IsCustom}">
              <DockPanel>
                <Button DockPanel.Dock="Right" Classes="outline" Margin="8,0,0,0" Content="{loc:Loc Settings.MergeTool.Browse}"
                        Command="{Binding BrowseCommand}" />
                <TextBox Text="{Binding CustomPath}" PlaceholderText="{loc:Loc Settings.MergeTool.PathWatermark}" />
              </DockPanel>
              <TextBox Classes="mono" Text="{Binding CustomArguments}" PlaceholderText="{loc:Loc Settings.MergeTool.ArgumentsWatermark}" />
              <TextBlock Classes="muted" TextWrapping="Wrap" Text="{loc:Loc Settings.MergeTool.ArgumentsHint}" />
              <Button Classes="outline" HorizontalAlignment="Left" Content="{loc:Loc Settings.MergeTool.Save}" Command="{Binding SaveCustomCommand}" />
            </StackPanel>

            <TextBlock Classes="danger" TextWrapping="Wrap" Text="{Binding Error}" IsVisible="{Binding HasError}" />
            <TextBlock Classes="muted" TextWrapping="Wrap" Text="{Binding SavedText}" />
            <TextBlock Classes="muted" TextWrapping="Wrap" Text="{loc:Loc Settings.MergeTool.Hint}" />
          </StackPanel>
        </Border>
      </StackPanel>

      <!-- Commits from the Workstation (Origin only): off unless the user allows them -->
      <StackPanel IsVisible="{Binding CanAcceptCommits}">
        <TextBlock Classes="section" Text="{loc:Loc Settings.Commits.Title}" />
        <Border Classes="card">
          <StackPanel Margin="16,14" Spacing="10">
            <CheckBox IsChecked="{Binding AcceptCommits}" IsEnabled="{Binding !IsBusy}" Command="{Binding SaveAcceptCommitsCommand}"
                      Content="{loc:Loc Settings.Commits.Accept}" />
            <TextBlock Classes="muted" TextWrapping="Wrap" Text="{loc:Loc Settings.Commits.Hint}" />
          </StackPanel>
        </Border>
      </StackPanel>

      <StackPanel>
        <TextBlock Classes="section" Text="{loc:Loc Settings.Data.Title}" />
        <Border Classes="card">
          <StackPanel Margin="16,14" Spacing="10">
            <TextBlock Classes="muted" TextWrapping="Wrap" Text="{loc:Loc Settings.Data.Hint}" />
            <Button Classes="outline" HorizontalAlignment="Left" IsEnabled="{Binding !IsBusy}"
                    Content="{loc:Loc Settings.Data.Clean}" Command="{Binding CleanDataCommand}" />
          </StackPanel>
        </Border>
      </StackPanel>

      <!-- About the application: the brand and the version at a glance, the full window and a letter about a problem. -->
      <StackPanel>
        <TextBlock Classes="section" Text="{loc:Loc Settings.About.Title}" />
        <Border Classes="card">
          <DockPanel Margin="16,14">
            <Image DockPanel.Dock="Left" Source="avares://RCynQ.UI/Assets/rcynq-256.png" Width="44" Height="44"
                   VerticalAlignment="Top" Margin="0,0,14,0" />
            <StackPanel Spacing="8">
              <StackPanel Orientation="Horizontal" Spacing="10">
                <TextBlock FontSize="18" FontWeight="Bold" VerticalAlignment="Center">
                  <Run Text="RC" Foreground="{StaticResource BrandBlueBrush}" /><Run Text="yn" /><Run Text="Q" Foreground="{StaticResource BrandVioletBrush}" />
                </TextBlock>
                <TextBlock Classes="muted mono" FontSize="12" VerticalAlignment="Center" Text="{Binding VersionText}" />
              </StackPanel>
              <TextBlock Classes="muted" TextWrapping="Wrap" Text="{loc:Loc Settings.About.Hint}" />
              <WrapPanel>
                <Button Classes="outline" Margin="0,0,8,0" Content="{loc:Loc Settings.About.Open}" Command="{Binding OpenAboutCommand}" />
                <Button Classes="outline" Content="{loc:Loc Problem.Report}" ToolTip.Tip="{loc:Loc Problem.ReportTip}"
                        Command="{Binding ReportProblemCommand}" />
              </WrapPanel>
            </StackPanel>
          </DockPanel>
        </Border>
      </StackPanel>

    </StackPanel>
  </ScrollViewer>
</UserControl>
