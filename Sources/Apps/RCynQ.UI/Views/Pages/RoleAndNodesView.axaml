<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="using:RCynQ.UI.Localization"
             xmlns:pages="using:RCynQ.UI.ViewModels.Pages"
             xmlns:items="using:RCynQ.UI.ViewModels.Items"
             xmlns:controls="using:RCynQ.UI.Controls"
             x:Class="RCynQ.UI.Views.Pages.RoleAndNodesView"
             x:DataType="pages:RoleAndNodesViewModel">
  <Grid RowDefinitions="*,Auto">
    <ScrollViewer>
      <StackPanel Margin="28,22,28,28" Spacing="18">

        <StackPanel>
          <TextBlock Classes="field-label" Text="{loc:Loc Field.NodeRole}" />
          <ComboBox ItemsSource="{Binding Roles}" SelectedItem="{Binding SelectedRole}" />
        </StackPanel>

        <StackPanel IsVisible="{Binding IsPathVisible}">
          <TextBlock Classes="field-label" Text="{Binding PathLabel}" />
          <Grid ColumnDefinitions="*,Auto">
            <TextBox Classes="mono" Text="{Binding Path}" PlaceholderText="/home/dev/projects/app" />
            <Button Grid.Column="1" Classes="outline" Margin="8,0,0,0" Content="{loc:Loc Common.Browse}" Command="{Binding BrowseCommand}" />
          </Grid>
        </StackPanel>

        <Border Classes="banner warning" IsVisible="{Binding IsDirty}">
          <Grid ColumnDefinitions="*,Auto">
            <TextBlock Text="{loc:Loc Roles.RoleHint}"
                       TextWrapping="Wrap" VerticalAlignment="Center" />
            <Button Grid.Column="1" Classes="accent" Margin="12,0,0,0" Content="{loc:Loc Common.Save}" Command="{Binding ApplyRoleCommand}" />
          </Grid>
        </Border>

        <StackPanel IsVisible="{Binding AreSettingsVisible}">
          <TextBlock Classes="section" Text="{loc:Loc Roles.NodeParameters}" />
          <Border Classes="card">
            <StackPanel Margin="16,14" Spacing="14">

              <StackPanel>
                <TextBlock Classes="field-label" Text="{loc:Loc Field.NodeId}" />
                <TextBox Classes="mono" Text="{Binding NodeId}" IsReadOnly="True" />
              </StackPanel>

              <StackPanel IsVisible="{Binding HasLinkToken}">
                <TextBlock Classes="field-label" Text="{loc:Loc Roles.LinkToken}" />
                <Grid ColumnDefinitions="*,Auto,Auto,Auto">
                  <TextBox Classes="mono" Text="{Binding LinkToken}" PasswordChar="{Binding TokenMaskChar}"
                           AutomationProperties.Name="{loc:Loc Roles.LinkTokenName}" />
                  <Button Grid.Column="1" Classes="outline" Margin="8,0,0,0" Content="{Binding RevealTokenText}"
                          Command="{Binding RevealTokenCommand}" />
                  <Button Grid.Column="2" Classes="outline" Margin="8,0,0,0" Content="{loc:Loc Common.Copy}"
                          Command="{Binding CopyTokenCommand}" />
                  <Button Grid.Column="3" Classes="outline" Margin="8,0,0,0" Content="{loc:Loc Roles.NewToken}"
                          ToolTip.Tip="{loc:Loc Roles.NewTokenTip}"
                          Command="{Binding NewTokenCommand}" />
                </Grid>
                <TextBlock Classes="muted" TextWrapping="Wrap" Margin="0,6,0,0"
                           Text="{loc:Loc Roles.LinkTokenHint}" />
              </StackPanel>

              <StackPanel IsVisible="{Binding IsEndpointModeVisible}">
                <TextBlock Classes="field-label" Text="{loc:Loc Endpoint.Title}" />
                <ComboBox ItemsSource="{Binding EndpointModes}" SelectedItem="{Binding SelectedEndpointMode}">
                  <ComboBox.ItemTemplate>
                    <DataTemplate x:DataType="items:EndpointModeOption">
                      <TextBlock Text="{Binding Title}" />
                    </DataTemplate>
                  </ComboBox.ItemTemplate>
                </ComboBox>
                <TextBlock Classes="muted" TextWrapping="Wrap" Margin="0,6,0,0" Text="{Binding EndpointHint}" />
              </StackPanel>

              <StackPanel IsVisible="{Binding !IsEndpointModeVisible}">
                <TextBlock Classes="field-label" Text="{loc:Loc Endpoint.Title}" />
                <TextBlock TextWrapping="Wrap"
                           Text="{loc:Loc Roles.RelayEndpointHint}" />
              </StackPanel>

              <StackPanel IsVisible="{Binding IsEndpointPortVisible}">
                <TextBlock Classes="field-label" Text="{loc:Loc Endpoint.Port}" />
                <NumericUpDown Value="{Binding EndpointPort}" Minimum="1" Maximum="65535" Increment="1" FormatString="0" />
                <TextBlock Classes="muted" TextWrapping="Wrap" Margin="0,6,0,0"
                           Text="{loc:Loc Endpoint.PortHint}" />
              </StackPanel>

              <Border Classes="banner warning" IsVisible="{Binding AreSettingsDirty}">
                <Grid ColumnDefinitions="*,Auto">
                  <TextBlock Text="{loc:Loc Roles.SettingsApplyHint}" TextWrapping="Wrap" VerticalAlignment="Center" />
                  <Button Grid.Column="1" Classes="accent" Margin="12,0,0,0" Content="{loc:Loc Common.Save}"
                          Command="{Binding SaveSettingsCommand}" />
                </Grid>
              </Border>

              <TextBlock Classes="muted mono" TextWrapping="Wrap" Text="{Binding ConfigPath}" />
            </StackPanel>
          </Border>
        </StackPanel>

        <StackPanel>
          <TextBlock Classes="section" Text="{loc:Loc Roles.Nodes}" />
          <Border Classes="card">
            <Panel>
              <TextBlock Classes="muted" Margin="16,14" TextWrapping="Wrap" IsVisible="{Binding HasNoNodes}"
                         Text="{loc:Loc Roles.NoNodes}" />
              <ItemsControl Classes="rows" ItemsSource="{Binding Nodes}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="items:ChainNodeItemViewModel">
                    <Border Classes="row">
                      <StackPanel Spacing="6">
                        <!-- One line per node; a node reachable at several addresses unfolds to list them when its line is clicked. -->
                        <Grid ColumnDefinitions="*,Auto">
                          <Button Classes="tree-row" Command="{Binding ToggleCommand}" IsHitTestVisible="{Binding HasRoutes}">
                            <Grid ColumnDefinitions="20,1.2*,*,1.3*,110">
                              <Panel HorizontalAlignment="Left" VerticalAlignment="Center" IsVisible="{Binding HasRoutes}">
                                <controls:IconView Width="14" Height="14" IconKey="Icon.ChevronRight" Foreground="{StaticResource TextMutedBrush}"
                                                   IsVisible="{Binding !IsExpanded}" />
                                <controls:IconView Width="14" Height="14" IconKey="Icon.ChevronDown" Foreground="{StaticResource TextMutedBrush}"
                                                   IsVisible="{Binding IsExpanded}" />
                              </Panel>
                              <TextBlock Grid.Column="1" Text="{Binding Name}" FontWeight="Medium" TextTrimming="CharacterEllipsis" />
                              <TextBlock Grid.Column="2" Classes="secondary" Text="{Binding Role}" />
                              <TextBlock Grid.Column="3" Classes="mono secondary" Text="{Binding Address}" TextTrimming="CharacterEllipsis" />
                              <TextBlock Grid.Column="4" Classes="status"
                                         Classes.online="{Binding IsOnline}"
                                         Classes.degraded="{Binding IsDegraded}"
                                         Classes.offline="{Binding IsOffline}"
                                         Text="{Binding StatusText}" />
                            </Grid>
                          </Button>
                          <Button Grid.Column="1" Classes="icon hover-only" Padding="5" ToolTip.Tip="{loc:Loc Roles.RemoveNode}"
                                  Command="{Binding $parent[ItemsControl].((pages:RoleAndNodesViewModel)DataContext).RemoveNodeCommand}"
                                  CommandParameter="{Binding}">
                            <controls:IconView Classes="small" IconKey="Icon.Trash" />
                          </Button>
                        </Grid>

                        <!-- The ways to the node: shown when it is reachable at more than one address and its line is unfolded. -->
                        <StackPanel Margin="38,0,0,0" Spacing="2" IsVisible="{Binding AreRoutesShown}">
                          <RadioButton IsChecked="{Binding IsAutoRoute, Mode=OneWay}"
                                       Content="{loc:Loc Routes.Auto}" ToolTip.Tip="{loc:Loc Routes.AutoTip}"
                                       Command="{Binding $parent[ItemsControl].((pages:RoleAndNodesViewModel)DataContext).AutoRouteCommand}"
                                       CommandParameter="{Binding}" />
                          <ItemsControl ItemsSource="{Binding Routes}">
                            <ItemsControl.ItemTemplate>
                              <DataTemplate x:DataType="items:LinkRouteItemViewModel">
                                <Grid ColumnDefinitions="Auto,1.3*,90,110,*,Auto,Auto,Auto">
                                  <RadioButton IsChecked="{Binding IsPinned, Mode=OneWay}" ToolTip.Tip="{loc:Loc Routes.PinTip}"
                                               Command="{Binding $parent[ItemsControl;1].((pages:RoleAndNodesViewModel)DataContext).SelectRouteCommand}"
                                               CommandParameter="{Binding}" />
                                  <TextBlock Grid.Column="1" Classes="mono secondary" VerticalAlignment="Center" Margin="6,0,0,0"
                                             Text="{Binding Address}" TextTrimming="CharacterEllipsis" />
                                  <TextBlock Grid.Column="2" Classes="status online" VerticalAlignment="Center" Text="{Binding ActiveText}" />
                                  <TextBlock Grid.Column="3" Classes="status" VerticalAlignment="Center"
                                             Classes.online="{Binding IsReachable}"
                                             Classes.offline="{Binding IsUnreachable}"
                                             Text="{Binding StatusText}" />
                                  <TextBlock Grid.Column="4" Classes="muted" VerticalAlignment="Center" Text="{Binding PriorityText}" />
                                  <Button Grid.Column="5" Classes="icon hover-only" Padding="5" Content="▲" ToolTip.Tip="{loc:Loc Routes.Raise}"
                                          Command="{Binding $parent[ItemsControl;1].((pages:RoleAndNodesViewModel)DataContext).RaiseRouteCommand}"
                                          CommandParameter="{Binding}" />
                                  <Button Grid.Column="6" Classes="icon hover-only" Padding="5" Content="▼" ToolTip.Tip="{loc:Loc Routes.Lower}"
                                          Command="{Binding $parent[ItemsControl;1].((pages:RoleAndNodesViewModel)DataContext).LowerRouteCommand}"
                                          CommandParameter="{Binding}" />
                                  <Button Grid.Column="7" Classes="icon hover-only" Padding="5" ToolTip.Tip="{loc:Loc Routes.Remove}"
                                          Command="{Binding $parent[ItemsControl;1].((pages:RoleAndNodesViewModel)DataContext).RemoveRouteCommand}"
                                          CommandParameter="{Binding}">
                                    <controls:IconView Classes="small" IconKey="Icon.Trash" />
                                  </Button>
                                </Grid>
                              </DataTemplate>
                            </ItemsControl.ItemTemplate>
                          </ItemsControl>
                        </StackPanel>
                      </StackPanel>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </Panel>
          </Border>
        </StackPanel>

      </StackPanel>
    </ScrollViewer>

    <!-- The actions of the page stay at the bottom while the page scrolls: the rarer ones as icons, then the main ones. -->
    <Border Grid.Row="1" Classes="action-bar">
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="6">
        <Button Classes="outline tool" AutomationProperties.Name="{loc:Loc Roles.Export}" Command="{Binding ExportCommand}">
          <ToolTip.Tip>
            <StackPanel Classes="tip">
              <TextBlock Classes="tip-title" Text="{loc:Loc Roles.Export}" />
            </StackPanel>
          </ToolTip.Tip>
          <controls:IconView Classes="small" IconKey="Icon.Upload" />
        </Button>
        <Button Classes="outline tool" AutomationProperties.Name="{loc:Loc Roles.Import}" Command="{Binding ImportCommand}">
          <ToolTip.Tip>
            <StackPanel Classes="tip">
              <TextBlock Classes="tip-title" Text="{loc:Loc Roles.Import}" />
            </StackPanel>
          </ToolTip.Tip>
          <controls:IconView Classes="small" IconKey="Icon.Download" />
        </Button>
        <Button Classes="outline tool" AutomationProperties.Name="{loc:Loc Nodes.AddNode}" Command="{Binding AddNodeCommand}">
          <ToolTip.Tip>
            <StackPanel Classes="tip">
              <TextBlock Classes="tip-title" Text="{loc:Loc Nodes.AddNode}" />
            </StackPanel>
          </ToolTip.Tip>
          <controls:IconView Classes="small" IconKey="Icon.Plus" />
        </Button>
        <Border Classes="toolbar-divider" />
        <Button Classes="outline" AutomationProperties.Name="{loc:Loc Roles.AllowAccess}"
                ToolTip.Tip="{loc:Loc Roles.AllowAccessTip}"
                Command="{Binding AllowAccessCommand}">
          <StackPanel Orientation="Horizontal" Spacing="8">
            <controls:IconView Classes="small" IconKey="Icon.Check" />
            <TextBlock Text="{loc:Loc Roles.AllowAccess}" />
          </StackPanel>
        </Button>
        <Button Classes="accent" Command="{Binding ConnectCommand}" IsVisible="{Binding CanConnect}">
          <StackPanel Orientation="Horizontal" Spacing="8">
            <controls:IconView Classes="small" IconKey="Icon.Send" />
            <TextBlock Text="{loc:Loc Roles.Connect}" />
          </StackPanel>
        </Button>
      </StackPanel>
    </Border>
  </Grid>
</UserControl>
