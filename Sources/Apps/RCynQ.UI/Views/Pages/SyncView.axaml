<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="using:RCynQ.UI.Localization"
             xmlns:pages="using:RCynQ.UI.ViewModels.Pages"
             xmlns:items="using:RCynQ.UI.ViewModels.Items"
             xmlns:controls="using:RCynQ.UI.Controls"
             x:Class="RCynQ.UI.Views.Pages.SyncView"
             x:DataType="pages:SyncViewModel">
  <ScrollViewer>
    <StackPanel Margin="28,22,28,28" Spacing="18">

      <Grid ColumnDefinitions="*,Auto">
        <WrapPanel>
          <StackPanel Spacing="2" Margin="0,0,32,0">
            <TextBlock Classes="muted" Text="{loc:Loc Field.Role}" />
            <TextBlock Classes="value" Text="{Binding RoleText}" />
          </StackPanel>
          <StackPanel Spacing="2" Margin="0,0,32,0">
            <TextBlock Classes="muted" Text="{loc:Loc Overview.LastSync}" />
            <TextBlock Classes="value mono" Text="{Binding LastSyncText}" />
          </StackPanel>
          <StackPanel Spacing="2" Margin="0,0,32,0" ToolTip.Tip="{loc:Loc Sync.BaseTip}">
            <TextBlock Classes="muted" Text="{loc:Loc Sync.Base}" />
            <TextBlock Classes="value mono" Text="{Binding SyncBaseText}" />
          </StackPanel>
          <StackPanel Spacing="2" IsVisible="{Binding HasConflicts}">
            <TextBlock Classes="muted" Text="{loc:Loc Sync.Conflicts}" />
            <TextBlock Classes="value danger" Text="{Binding ConflictCount}" />
          </StackPanel>
        </WrapPanel>
        <Button Grid.Column="1" Classes="accent" VerticalAlignment="Center" Command="{Binding SendCommand}">
          <StackPanel Orientation="Horizontal" Spacing="8">
            <controls:IconView Classes="small" IconKey="Icon.Send" />
            <TextBlock Text="{loc:Loc Sync.Send}" />
          </StackPanel>
        </Button>
      </Grid>

      <Border Classes="banner warning" IsVisible="{Binding NeedsSyncBase}">
        <Grid ColumnDefinitions="Auto,*,Auto">
          <controls:IconView IconKey="Icon.Alert" Foreground="{StaticResource WarningBrush}" Margin="0,0,10,0" />
          <TextBlock Grid.Column="1" TextWrapping="Wrap" VerticalAlignment="Center"
                     Text="{Binding SyncBaseProblem}" />
          <Button Grid.Column="2" Classes="outline" Margin="12,0,0,0" Content="{loc:Loc Sync.CreateBaseline}"
                  IsVisible="{Binding CanCreateManualBaseline}" Command="{Binding CreateBaselineCommand}" />
        </Grid>
      </Border>

      <StackPanel>
        <Grid ColumnDefinitions="*,Auto" Margin="0,0,0,14">
          <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
            <TextBlock Classes="section" Margin="0" VerticalAlignment="Center" Text="{loc:Loc Sync.Pending}" />
            <TextBlock Classes="muted" VerticalAlignment="Center" Text="{Binding CountText}" />
          </StackPanel>
          <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
            <Button Classes="outline" Classes.toggled="{Binding IsSelectionMode}" ToolTip.Tip="{loc:Loc Sync.SelectFilesTip}"
                    Command="{Binding ToggleSelectionModeCommand}">
              <StackPanel Orientation="Horizontal" Spacing="8">
                <controls:IconView Classes="small" IconKey="Icon.Check" />
                <TextBlock Text="{loc:Loc Sync.SelectFiles}" />
              </StackPanel>
            </Button>
            <Button Classes="outline" IsEnabled="{Binding !IsBusy}" Content="{loc:Loc Sync.Scan}" ToolTip.Tip="{loc:Loc Sync.ScanTip}" Command="{Binding ScanCommand}" />
            <Button Classes="outline" IsEnabled="{Binding !IsBusy}" Content="{Binding RebuildButtonText}" ToolTip.Tip="{loc:Loc Sync.RebuildTip}"
                    IsVisible="{Binding CanRebuildBaseline}" Command="{Binding CreateBaselineCommand}" />
          </StackPanel>
        </Grid>
        <Border Classes="card">
          <StackPanel>
            <Border IsVisible="{Binding IsSelectionMode}" Padding="12,8" BorderBrush="{StaticResource DividerBrush}" BorderThickness="0,0,0,1">
              <StackPanel Orientation="Horizontal" Spacing="8">
                <Button Classes="outline" Padding="10,3" MinHeight="26" FontSize="12" Content="{loc:Loc Sync.SelectAll}" Command="{Binding SelectAllCommand}" />
                <Button Classes="outline" Padding="10,3" MinHeight="26" FontSize="12" Content="{loc:Loc Sync.ClearSelection}" Command="{Binding ClearSelectionCommand}" />
              </StackPanel>
            </Border>
            <Panel>
              <TextBlock Classes="muted" Margin="16,14" IsVisible="{Binding HasNoChangedFiles}" Text="{loc:Loc Sync.NoPending}" />
              <ScrollViewer MaxHeight="240">
                <ItemsControl Classes="rows" ItemsSource="{Binding ChangedFiles}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="items:ChangedFileItemViewModel">
                      <Border Classes="row" Classes.selected="{Binding IsSelected}" Padding="16,6">
                        <Panel>
                          <Grid ColumnDefinitions="22,*,Auto" IsVisible="{Binding !IsSelectable}">
                            <TextBlock Classes="mono muted" FontSize="12.5" Text="{Binding KindText}" />
                            <TextBlock Grid.Column="1" Classes="mono secondary" FontSize="12.5" Text="{Binding Path}" TextTrimming="CharacterEllipsis" />
                            <TextBlock Grid.Column="2" Classes="muted" FontSize="12" Margin="12,0,0,0" IsVisible="{Binding AlreadySent}"
                                       Text="{loc:Loc Sync.AlreadySent}" ToolTip.Tip="{loc:Loc Sync.AlreadySentTip}" />
                          </Grid>
                          <CheckBox IsVisible="{Binding IsSelectable}" IsChecked="{Binding IsSelected}"
                                    HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" MinHeight="0" Padding="8,0,0,0">
                            <Grid ColumnDefinitions="22,*,Auto">
                              <TextBlock Classes="mono muted" FontSize="12.5" Text="{Binding KindText}" />
                              <TextBlock Grid.Column="1" Classes="mono secondary" FontSize="12.5" Text="{Binding Path}" TextTrimming="CharacterEllipsis" />
                              <TextBlock Grid.Column="2" Classes="muted" FontSize="12" Margin="12,0,0,0" IsVisible="{Binding AlreadySent}"
                                         Text="{loc:Loc Sync.AlreadySent}" ToolTip.Tip="{loc:Loc Sync.AlreadySentTip}" />
                            </Grid>
                          </CheckBox>
                        </Panel>
                      </Border>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </ScrollViewer>
            </Panel>
          </StackPanel>
        </Border>
      </StackPanel>

      <StackPanel>
        <TextBlock Classes="section" Text="{loc:Loc Sync.History}" />
        <Border Classes="card">
          <StackPanel>
            <Border Classes="header-row">
              <Grid ColumnDefinitions="160,110,70,*,Auto">
                <TextBlock Text="{loc:Loc Sync.Time}" />
                <TextBlock Grid.Column="1" Text="{loc:Loc Sync.Direction}" />
                <TextBlock Grid.Column="2" Text="{loc:Loc Sync.Files}" />
                <TextBlock Grid.Column="3" Text="{loc:Loc Common.Status}" />
              </Grid>
            </Border>
            <TextBlock Classes="muted" Margin="16,14" IsVisible="{Binding HasNoHistory}" Text="{loc:Loc Sync.NoHistory}" />
            <ItemsControl Classes="rows" ItemsSource="{Binding History}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="items:PatchHistoryItemViewModel">
                  <Border Classes="row" Padding="16,7">
                    <Grid ColumnDefinitions="160,110,70,*,Auto">
                      <TextBlock Classes="mono secondary" FontSize="12.5" Text="{Binding TimeText}" />
                      <TextBlock Grid.Column="1" Classes="secondary" Text="{Binding DirectionText}" />
                      <TextBlock Grid.Column="2" Classes="mono secondary" Text="{Binding FileCount}" />
                      <TextBlock Grid.Column="3" Classes="status"
                                 Classes.online="{Binding IsSuccess}"
                                 Classes.offline="{Binding IsProblem}"
                                 Text="{Binding StatusText}"
                                 ToolTip.Tip="{Binding ErrorText}" />
                      <StackPanel Grid.Column="4" Orientation="Horizontal" Spacing="6">
                        <Button Classes="outline" Padding="10,4" MinHeight="28" Content="{loc:Loc Sync.Resolve}" IsVisible="{Binding CanResolve}"
                                Command="{Binding $parent[ItemsControl].((pages:SyncViewModel)DataContext).ResolveCommand}"
                                CommandParameter="{Binding}" />
                        <Button Classes="icon" Padding="6" ToolTip.Tip="{loc:Loc Sync.ShowDiff}"
                                Command="{Binding $parent[ItemsControl].((pages:SyncViewModel)DataContext).ViewDiffCommand}"
                                CommandParameter="{Binding}">
                          <controls:IconView Classes="small" IconKey="Icon.Diff" />
                        </Button>
                      </StackPanel>
                    </Grid>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </Border>
      </StackPanel>

    </StackPanel>
  </ScrollViewer>
</UserControl>
