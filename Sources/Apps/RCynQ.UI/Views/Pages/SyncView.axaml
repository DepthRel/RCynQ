<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="using:RCynQ.UI.Localization"
             xmlns:pages="using:RCynQ.UI.ViewModels.Pages"
             xmlns:items="using:RCynQ.UI.ViewModels.Items"
             xmlns:controls="using:RCynQ.UI.Controls"
             x:Class="RCynQ.UI.Views.Pages.SyncView"
             x:DataType="pages:SyncViewModel">
  <ScrollViewer x:Name="PageScroll">
    <StackPanel Margin="28,22,28,28" Spacing="18">

      <Grid ColumnDefinitions="*,Auto">
        <WrapPanel>
          <StackPanel Spacing="2" Margin="0,0,32,0">
            <TextBlock Classes="muted" Text="{loc:Loc Field.Role}" />
            <TextBlock Classes="value" Text="{Binding RoleText}" />
          </StackPanel>
          <StackPanel Spacing="2" Margin="0,0,32,0">
            <TextBlock Classes="muted" Text="{loc:Loc Overview.LastSync}" />
            <TextBlock Classes="value mono" Text="{Binding LastSyncText}" />
          </StackPanel>
          <StackPanel Spacing="2" Margin="0,0,32,0" ToolTip.Tip="{loc:Loc Sync.BaseTip}">
            <TextBlock Classes="muted" Text="{loc:Loc Sync.Base}" />
            <TextBlock Classes="value mono" Text="{Binding SyncBaseText}" />
          </StackPanel>
          <StackPanel Spacing="2" IsVisible="{Binding HasConflicts}">
            <TextBlock Classes="muted" Text="{loc:Loc Sync.Conflicts}" />
            <TextBlock Classes="value danger" Text="{Binding ConflictCount}" />
          </StackPanel>
        </WrapPanel>
        <Button Grid.Column="1" Classes="accent" VerticalAlignment="Center" Command="{Binding SendCommand}">
          <StackPanel Orientation="Horizontal" Spacing="8">
            <controls:IconView Classes="small" IconKey="Icon.Send" />
            <TextBlock Text="{loc:Loc Sync.Send}" />
          </StackPanel>
        </Button>
      </Grid>

      <Border Classes="banner warning" IsVisible="{Binding NeedsSyncBase}">
        <Grid ColumnDefinitions="Auto,*,Auto">
          <controls:IconView IconKey="Icon.Alert" Foreground="{StaticResource WarningBrush}" Margin="0,0,10,0" />
          <TextBlock Grid.Column="1" TextWrapping="Wrap" VerticalAlignment="Center"
                     Text="{Binding SyncBaseProblem}" />
          <Button Grid.Column="2" Classes="outline" Margin="12,0,0,0" Content="{loc:Loc Sync.CreateBaseline}"
                  IsVisible="{Binding CanCreateManualBaseline}" Command="{Binding CreateBaselineCommand}" />
        </Grid>
      </Border>

      <!-- Changes to send -->
      <StackPanel>
        <Grid ColumnDefinitions="*,Auto" Margin="0,0,0,12">
          <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
            <TextBlock Classes="section" Margin="0" VerticalAlignment="Center" Text="{loc:Loc Sync.Pending}" />
            <TextBlock Classes="muted" VerticalAlignment="Center" Text="{Binding CountText}" />
          </StackPanel>
          <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6">
            <Button Classes="outline tool" Classes.toggled="{Binding IsSearchOpen}" Command="{Binding ToggleSearchCommand}">
              <ToolTip.Tip>
                <StackPanel Classes="tip">
                  <TextBlock Classes="tip-title" Text="{loc:Loc Sync.Search}" />
                  <TextBlock Classes="tip-text" Text="{loc:Loc Sync.SearchTip}" />
                </StackPanel>
              </ToolTip.Tip>
              <controls:IconView Classes="small" IconKey="Icon.Search" />
            </Button>
            <StackPanel Orientation="Horizontal">
              <Button Classes="outline tool segment-start" Classes.toggled="{Binding !IsTreeView}" Command="{Binding ShowFlatCommand}">
                <ToolTip.Tip>
                  <StackPanel Classes="tip">
                    <TextBlock Classes="tip-title" Text="{loc:Loc Sync.ViewFlat}" />
                    <TextBlock Classes="tip-text" Text="{loc:Loc Sync.ViewFlatTip}" />
                  </StackPanel>
                </ToolTip.Tip>
                <controls:IconView Classes="small" IconKey="Icon.List" />
              </Button>
              <Button Classes="outline tool segment-end" Classes.toggled="{Binding IsTreeView}" Command="{Binding ShowTreeCommand}">
                <ToolTip.Tip>
                  <StackPanel Classes="tip">
                    <TextBlock Classes="tip-title" Text="{loc:Loc Sync.ViewTree}" />
                    <TextBlock Classes="tip-text" Text="{loc:Loc Sync.ViewTreeTip}" />
                  </StackPanel>
                </ToolTip.Tip>
                <controls:IconView Classes="small" IconKey="Icon.Tree" />
              </Button>
            </StackPanel>
            <Border Classes="toolbar-divider" />
            <Button Classes="outline tool" Classes.toggled="{Binding IsSelectionMode}" Command="{Binding ToggleSelectionModeCommand}">
              <ToolTip.Tip>
                <StackPanel Classes="tip">
                  <TextBlock Classes="tip-title" Text="{loc:Loc Sync.SelectFiles}" />
                  <TextBlock Classes="tip-text" Text="{loc:Loc Sync.SelectFilesTip}" />
                </StackPanel>
              </ToolTip.Tip>
              <controls:IconView Classes="small" IconKey="Icon.SquareCheck" />
            </Button>
            <Button Classes="outline tool" IsEnabled="{Binding !IsBusy}" Command="{Binding ScanCommand}">
              <ToolTip.Tip>
                <StackPanel Classes="tip">
                  <TextBlock Classes="tip-title" Text="{loc:Loc Sync.Scan}" />
                  <TextBlock Classes="tip-text" Text="{loc:Loc Sync.ScanTip}" />
                </StackPanel>
              </ToolTip.Tip>
              <controls:IconView Classes="small" IconKey="Icon.Scan" />
            </Button>
            <Button Classes="outline tool" IsEnabled="{Binding !IsBusy}" IsVisible="{Binding CanRebuildBaseline}" Command="{Binding CreateBaselineCommand}">
              <ToolTip.Tip>
                <StackPanel Classes="tip">
                  <TextBlock Classes="tip-title" Text="{Binding RebuildButtonText}" />
                  <TextBlock Classes="tip-text" Text="{loc:Loc Sync.RebuildTip}" />
                </StackPanel>
              </ToolTip.Tip>
              <controls:IconView Classes="small" IconKey="Icon.Database" />
            </Button>
          </StackPanel>
        </Grid>

        <TextBox x:Name="SearchBox" Margin="0,0,0,12" IsVisible="{Binding IsSearchOpen}"
                 Text="{Binding FilterText}" PlaceholderText="{loc:Loc Sync.SearchPlaceholder}">
          <TextBox.KeyBindings>
            <KeyBinding Gesture="Escape" Command="{Binding CloseSearchCommand}" />
          </TextBox.KeyBindings>
          <TextBox.InnerLeftContent>
            <controls:IconView Classes="small" IconKey="Icon.Search" Margin="10,0,0,0" Foreground="{StaticResource TextMutedBrush}" />
          </TextBox.InnerLeftContent>
          <TextBox.InnerRightContent>
            <Button Classes="icon" Padding="4" Margin="0,0,6,0" IsVisible="{Binding IsFiltering}" ToolTip.Tip="{loc:Loc Sync.SearchClear}"
                    Command="{Binding ClearFilterCommand}">
              <controls:IconView Classes="small" IconKey="Icon.X" />
            </Button>
          </TextBox.InnerRightContent>
        </TextBox>

        <Border Classes="card">
          <StackPanel>
            <Border IsVisible="{Binding IsSelectionMode}" Padding="12,8" BorderBrush="{StaticResource DividerBrush}" BorderThickness="0,0,0,1">
              <StackPanel Orientation="Horizontal" Spacing="8">
                <Button Classes="outline" Padding="10,3" MinHeight="26" FontSize="12" Content="{loc:Loc Sync.SelectAll}" Command="{Binding SelectAllCommand}" />
                <Button Classes="outline" Padding="10,3" MinHeight="26" FontSize="12" Content="{loc:Loc Sync.ClearSelection}" Command="{Binding ClearSelectionCommand}" />
              </StackPanel>
            </Border>
            <Panel>
              <TextBlock Classes="muted" Margin="16,14" IsVisible="{Binding HasNoChangedFiles}" Text="{loc:Loc Sync.NoPending}" />
              <TextBlock Classes="muted" Margin="16,14" IsVisible="{Binding HasNoMatches}" Text="{Binding NoMatchesText}" TextWrapping="Wrap" />
              <ScrollViewer MaxHeight="320">
                <ItemsControl Classes="rows" ItemsSource="{Binding Rows}">
                  <ItemsControl.DataTemplates>

                    <!-- A folder of the tree: the arrow and the name open or close it, the check mark checks every file below -->
                    <DataTemplate DataType="items:ChangedFolderItemViewModel">
                      <Border Classes="row" Padding="16,6">
                        <DockPanel>
                          <Border DockPanel.Dock="Left" Width="{Binding IndentWidth}" />
                          <Button DockPanel.Dock="Left" Classes="tree-row" Width="20" Command="{Binding ToggleCommand}">
                            <Panel HorizontalAlignment="Left">
                              <controls:IconView Width="14" Height="14" IconKey="Icon.ChevronRight" Foreground="{StaticResource TextMutedBrush}"
                                                 IsVisible="{Binding !IsExpanded}" />
                              <controls:IconView Width="14" Height="14" IconKey="Icon.ChevronDown" Foreground="{StaticResource TextMutedBrush}"
                                                 IsVisible="{Binding IsExpanded}" />
                            </Panel>
                          </Button>
                          <CheckBox DockPanel.Dock="Left" IsVisible="{Binding IsSelectable}" IsChecked="{Binding IsChecked}"
                                    MinHeight="0" MinWidth="0" Padding="0" Margin="0,-7,8,-7" VerticalAlignment="Center" />
                          <Button Classes="tree-row" Command="{Binding ToggleCommand}" ToolTip.Tip="{Binding Path}">
                            <Grid ColumnDefinitions="22,*,Auto">
                              <controls:IconView Classes="small" IconKey="Icon.Folder" HorizontalAlignment="Left" Foreground="{StaticResource BrandBlueBrush}" />
                              <TextBlock Grid.Column="1" Classes="mono" FontSize="12.5" Text="{Binding Label}" TextTrimming="CharacterEllipsis" />
                              <TextBlock Grid.Column="2" Classes="muted mono" FontSize="12" Margin="12,0,0,0" Text="{Binding FileCount}" />
                            </Grid>
                          </Button>
                        </DockPanel>
                      </Border>
                    </DataTemplate>

                    <!-- A file: its path in the flat list, its name under its folder in the tree -->
                    <DataTemplate DataType="items:ChangedFileItemViewModel">
                      <Border Classes="row" Classes.selected="{Binding IsSelected}" Padding="16,6">
                        <DockPanel>
                          <Border DockPanel.Dock="Left" Width="{Binding IndentWidth}" />
                          <Panel>
                            <Grid ColumnDefinitions="22,*,Auto" IsVisible="{Binding !IsSelectable}">
                              <TextBlock Classes="mono muted" FontSize="12.5" Text="{Binding KindText}" />
                              <TextBlock Grid.Column="1" Classes="mono secondary" FontSize="12.5" Text="{Binding Label}" TextTrimming="CharacterEllipsis"
                                         ToolTip.Tip="{Binding Path}" />
                              <TextBlock Grid.Column="2" Classes="muted" FontSize="12" Margin="12,0,0,0" IsVisible="{Binding AlreadySent}"
                                         Text="{loc:Loc Sync.AlreadySent}" ToolTip.Tip="{loc:Loc Sync.AlreadySentTip}" />
                            </Grid>
                            <CheckBox IsVisible="{Binding IsSelectable}" IsChecked="{Binding IsSelected}"
                                      HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" MinHeight="0" Padding="8,0,0,0" Margin="0,-7">
                              <Grid ColumnDefinitions="22,*,Auto">
                                <TextBlock Classes="mono muted" FontSize="12.5" Text="{Binding KindText}" />
                                <TextBlock Grid.Column="1" Classes="mono secondary" FontSize="12.5" Text="{Binding Label}" TextTrimming="CharacterEllipsis"
                                           ToolTip.Tip="{Binding Path}" />
                                <TextBlock Grid.Column="2" Classes="muted" FontSize="12" Margin="12,0,0,0" IsVisible="{Binding AlreadySent}"
                                           Text="{loc:Loc Sync.AlreadySent}" ToolTip.Tip="{loc:Loc Sync.AlreadySentTip}" />
                              </Grid>
                            </CheckBox>
                          </Panel>
                        </DockPanel>
                      </Border>
                    </DataTemplate>

                  </ItemsControl.DataTemplates>
                </ItemsControl>
              </ScrollViewer>
            </Panel>
          </StackPanel>
        </Border>
      </StackPanel>

      <!-- Patch history: the newest rows, or every loaded row with older pages loaded below on demand -->
      <StackPanel>
        <Grid ColumnDefinitions="*,Auto" Margin="0,0,0,10">
          <TextBlock Classes="section" Margin="0" VerticalAlignment="Center" Text="{loc:Loc Sync.History}" />
          <Button Grid.Column="1" Classes="outline tool" Width="30" Height="30" IsVisible="{Binding CanToggleHistory}"
                  ToolTip.Tip="{Binding HistoryToggleTip}" Command="{Binding ToggleHistoryCommand}">
            <Panel>
              <controls:IconView Classes="small" IconKey="Icon.ChevronDown" IsVisible="{Binding !IsHistoryExpanded}" />
              <controls:IconView Classes="small" IconKey="Icon.ChevronUp" IsVisible="{Binding IsHistoryExpanded}" />
            </Panel>
          </Button>
        </Grid>
        <Border Classes="card">
          <StackPanel>
            <Border Classes="header-row">
              <Grid ColumnDefinitions="160,110,70,*,Auto">
                <TextBlock Text="{loc:Loc Sync.Time}" />
                <TextBlock Grid.Column="1" Text="{loc:Loc Sync.Direction}" />
                <TextBlock Grid.Column="2" Text="{loc:Loc Sync.Files}" />
                <TextBlock Grid.Column="3" Text="{loc:Loc Common.Status}" />
              </Grid>
            </Border>
            <TextBlock Classes="muted" Margin="16,14" IsVisible="{Binding HasNoHistory}" Text="{loc:Loc Sync.NoHistory}" />
            <ItemsControl Classes="rows" ItemsSource="{Binding ShownHistory}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="items:PatchHistoryItemViewModel">
                  <Border Classes="row" Padding="16,7">
                    <Grid ColumnDefinitions="160,110,70,*,Auto">
                      <TextBlock Classes="mono secondary" FontSize="12.5" Text="{Binding TimeText}" />
                      <TextBlock Grid.Column="1" Classes="secondary" Text="{Binding DirectionText}" />
                      <TextBlock Grid.Column="2" Classes="mono secondary" Text="{Binding FileCount}" />
                      <TextBlock Grid.Column="3" Classes="status"
                                 Classes.online="{Binding IsSuccess}"
                                 Classes.offline="{Binding IsProblem}"
                                 Text="{Binding StatusText}"
                                 ToolTip.Tip="{Binding ErrorText}" />
                      <StackPanel Grid.Column="4" Orientation="Horizontal" Spacing="6">
                        <Button Classes="outline" Padding="10,4" MinHeight="28" Content="{loc:Loc Sync.Resolve}" IsVisible="{Binding CanResolve}"
                                Command="{Binding $parent[ItemsControl].((pages:SyncViewModel)DataContext).ResolveCommand}"
                                CommandParameter="{Binding}" />
                        <Button Classes="icon" Padding="6" ToolTip.Tip="{loc:Loc Sync.ShowDiff}"
                                Command="{Binding $parent[ItemsControl].((pages:SyncViewModel)DataContext).ViewDiffCommand}"
                                CommandParameter="{Binding}">
                          <controls:IconView Classes="small" IconKey="Icon.Diff" />
                        </Button>
                      </StackPanel>
                    </Grid>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
            <Border IsVisible="{Binding CanLoadMoreHistory}" Padding="12,8" BorderBrush="{StaticResource DividerBrush}" BorderThickness="0,1,0,0">
              <Button Classes="outline" HorizontalAlignment="Center" Padding="14,3" MinHeight="28" FontSize="12"
                      IsEnabled="{Binding !IsLoadingMoreHistory}" Command="{Binding LoadMoreHistoryCommand}">
                <StackPanel Orientation="Horizontal" Spacing="6">
                  <controls:IconView Classes="small" IconKey="Icon.ChevronDown" />
                  <TextBlock Text="{loc:Loc Sync.HistoryLoadMore}" />
                </StackPanel>
              </Button>
            </Border>
          </StackPanel>
        </Border>
      </StackPanel>

    </StackPanel>
  </ScrollViewer>
</UserControl>
