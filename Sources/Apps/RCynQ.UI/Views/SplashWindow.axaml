<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="using:RCynQ.UI.Localization"
        x:Class="RCynQ.UI.Views.SplashWindow"
        Title="RCynQ"
        Icon="avares://RCynQ.UI/Assets/rcynq.ico"
        Width="380" Height="270"
        CanResize="False" ShowInTaskbar="False" Topmost="True"
        WindowDecorations="None"
        Background="Transparent" TransparencyLevelHint="Transparent"
        WindowStartupLocation="CenterScreen">
  <!--
    Shown while the application prepares itself: it reads its settings, builds the window and starts the service. The
    main window appears only when everything is ready.
  -->
  <Border Background="{StaticResource CardBackgroundBrush}"
          BorderBrush="{StaticResource BorderBrush}"
          BorderThickness="1"
          CornerRadius="14">
    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="14" Margin="28">
      <Image Source="avares://RCynQ.UI/Assets/rcynq-256.png" Width="96" Height="96" HorizontalAlignment="Center" />
      <TextBlock Classes="page-title" FontSize="24" Text="RCynQ" HorizontalAlignment="Center" />
      <ProgressBar Classes="thin" IsIndeterminate="True" Width="220" Height="3" HorizontalAlignment="Center" />
      <StackPanel Spacing="3" HorizontalAlignment="Center">
        <TextBlock Classes="secondary" HorizontalAlignment="Center" Text="{loc:Loc Splash.Loading}" />
        <TextBlock x:Name="Step" Classes="muted" FontSize="12" HorizontalAlignment="Center" TextAlignment="Center"
                   Text="{loc:Loc Splash.Preparing}" />
      </StackPanel>
    </StackPanel>
  </Border>
</Window>
