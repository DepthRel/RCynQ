<dialogs:DialogWindow xmlns="https://github.com/avaloniaui"
                     xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                     xmlns:dialogs="using:RCynQ.UI.Views.Dialogs"
                     xmlns:vm="using:RCynQ.UI.ViewModels.Dialogs"
                     x:Class="RCynQ.UI.Views.Dialogs.ConfirmDialog"
                     x:DataType="vm:ConfirmDialogViewModel"
                     Title="{Binding Title}"
                     Width="460" SizeToContent="Height" CanResize="False"
                     WindowStartupLocation="CenterOwner">
  <StackPanel Margin="22" Spacing="14">
    <TextBlock Classes="page-title" Text="{Binding Title}" />
    <TextBlock Classes="secondary" Text="{Binding Message}" TextWrapping="Wrap" />
    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="10">
      <Button Classes="outline" Content="Отмена" IsCancel="True" Command="{Binding CancelCommand}" />
      <Button Classes="accent" Content="Подтвердить" IsDefault="True" Command="{Binding ConfirmCommand}" />
    </StackPanel>
  </StackPanel>
</dialogs:DialogWindow>
