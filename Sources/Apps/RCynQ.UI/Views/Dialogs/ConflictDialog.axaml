<dialogs:DialogWindow xmlns="https://github.com/avaloniaui"
                     xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                     xmlns:loc="using:RCynQ.UI.Localization"
                     xmlns:dialogs="using:RCynQ.UI.Views.Dialogs"
                     xmlns:vm="using:RCynQ.UI.ViewModels.Dialogs"
                     xmlns:items="using:RCynQ.UI.ViewModels.Items"
                     xmlns:controls="using:RCynQ.UI.Controls"
                     x:Class="RCynQ.UI.Views.Dialogs.ConflictDialog"
                     x:DataType="vm:ConflictDialogViewModel"
                     Title="{loc:Loc Conflict.WindowTitle}"
                     Width="640" SizeToContent="Height" CanResize="False"
                     WindowStartupLocation="CenterOwner">
  <dialogs:DialogWindow.Styles>
    <Style Selector="Button.choice">
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="HorizontalContentAlignment" Value="Left" />
      <Setter Property="Padding" Value="14,10" />
    </Style>
  </dialogs:DialogWindow.Styles>

  <StackPanel Margin="22" Spacing="14">
    <StackPanel Orientation="Horizontal" Spacing="10">
      <controls:IconView IconKey="Icon.Alert" Width="22" Height="22" Foreground="{StaticResource WarningBrush}" />
      <TextBlock Classes="page-title" Text="{loc:Loc Conflict.Title}" VerticalAlignment="Center" />
    </StackPanel>
    <TextBlock Classes="secondary" Text="{Binding Header}" TextWrapping="Wrap" />

    <Border Classes="card" MaxHeight="220" IsVisible="{Binding Files.Count}">
      <ScrollViewer>
        <ItemsControl Classes="rows" ItemsSource="{Binding Files}">
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="items:ConflictFileItemViewModel">
              <Border Classes="row" Padding="14,7">
                <StackPanel Spacing="2">
                  <TextBlock Classes="mono" FontSize="12.5" Text="{Binding Path}" TextWrapping="Wrap" />
                  <TextBlock Classes="muted" FontSize="12" Text="{Binding Detail}" TextWrapping="Wrap"
                             IsVisible="{Binding HasDetail}" />
                </StackPanel>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </ScrollViewer>
    </Border>

    <StackPanel Spacing="8">
      <Button Classes="outline choice" Command="{Binding KeepLocalCommand}">
        <StackPanel Spacing="2">
          <TextBlock Text="{loc:Loc Conflict.KeepLocal}" FontWeight="Medium" />
          <TextBlock Classes="muted" FontSize="12" TextWrapping="Wrap" Text="{loc:Loc Conflict.KeepLocal.Hint}" />
        </StackPanel>
      </Button>
      <Button Classes="outline choice" Command="{Binding ApplyIncomingCommand}">
        <StackPanel Spacing="2">
          <TextBlock Text="{loc:Loc Conflict.ApplyIncoming}" FontWeight="Medium" />
          <TextBlock Classes="muted" FontSize="12" TextWrapping="Wrap" Text="{loc:Loc Conflict.ApplyIncoming.Hint}" />
        </StackPanel>
      </Button>
      <Button Classes="outline choice" Command="{Binding UseGitCommand}">
        <StackPanel Spacing="2">
          <TextBlock Text="{loc:Loc Conflict.UseGit}" FontWeight="Medium" />
          <TextBlock Classes="muted" FontSize="12" TextWrapping="Wrap" Text="{loc:Loc Conflict.UseGit.Hint}" />
        </StackPanel>
      </Button>
    </StackPanel>

    <Button Classes="outline" HorizontalAlignment="Right" Content="{loc:Loc Common.Cancel}" IsCancel="True" Command="{Binding CancelCommand}" />
  </StackPanel>
</dialogs:DialogWindow>
