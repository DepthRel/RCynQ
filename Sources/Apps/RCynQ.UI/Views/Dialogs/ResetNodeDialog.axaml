<dialogs:DialogWindow xmlns="https://github.com/avaloniaui"
                     xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                     xmlns:loc="using:RCynQ.UI.Localization"
                     xmlns:dialogs="using:RCynQ.UI.Views.Dialogs"
                     xmlns:vm="using:RCynQ.UI.ViewModels.Dialogs"
                     x:Class="RCynQ.UI.Views.Dialogs.ResetNodeDialog"
                     x:DataType="vm:ResetNodeDialogViewModel"
                     Title="{loc:Loc Reset.Title}"
                     Width="560" SizeToContent="Height" CanResize="False"
                     WindowStartupLocation="CenterOwner">
  <StackPanel Margin="22" Spacing="14">
    <TextBlock Classes="page-title danger" Text="{loc:Loc Reset.Title}" />
    <TextBlock Classes="secondary" TextWrapping="Wrap" Text="{loc:Loc Reset.Dialog.Intro}" />

    <!-- What goes, as a list: the configuration and the data with their paths under them, the lines in authorized_keys. -->
    <Grid ColumnDefinitions="22,*" RowDefinitions="Auto,Auto,Auto" Margin="6,0,0,0">
      <TextBlock Grid.Row="0" Text="•" FontWeight="Bold" />
      <StackPanel Grid.Row="0" Grid.Column="1" Spacing="2" Margin="0,0,0,10">
        <TextBlock TextWrapping="Wrap" Text="{Binding ConfigText}" />
        <SelectableTextBlock Classes="muted mono" FontSize="12" TextWrapping="Wrap" Text="{Binding ConfigPath}" />
      </StackPanel>

      <TextBlock Grid.Row="1" Text="•" FontWeight="Bold" />
      <StackPanel Grid.Row="1" Grid.Column="1" Spacing="2" Margin="0,0,0,10">
        <TextBlock TextWrapping="Wrap" Text="{Binding DataText}" />
        <SelectableTextBlock Classes="muted mono" FontSize="12" TextWrapping="Wrap" Text="{Binding DataPath}" />
      </StackPanel>

      <TextBlock Grid.Row="2" Text="•" FontWeight="Bold" />
      <TextBlock Grid.Row="2" Grid.Column="1" TextWrapping="Wrap" Text="{loc:Loc Reset.Access}" />
    </Grid>

    <TextBlock Classes="muted" TextWrapping="Wrap" Text="{loc:Loc Reset.Stays}" />
    <TextBlock Classes="muted" TextWrapping="Wrap" Text="{loc:Loc Reset.Neighbours}" />
    <TextBlock Classes="danger" TextWrapping="Wrap" Text="{loc:Loc Reset.Irreversible}" />

    <!-- As on GitHub: the button wakes up only once the identifier of the node is typed. -->
    <StackPanel Spacing="6">
      <TextBlock TextWrapping="Wrap" Text="{Binding PromptText}" />
      <TextBox Classes="mono" Text="{Binding Typed}" />
    </StackPanel>

    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="10">
      <Button Classes="outline" Content="{loc:Loc Common.Cancel}" IsCancel="True" Command="{Binding CancelCommand}" />
      <Button Classes="danger" Content="{loc:Loc Reset.Confirm}" Command="{Binding ConfirmCommand}" />
    </StackPanel>
  </StackPanel>
</dialogs:DialogWindow>
