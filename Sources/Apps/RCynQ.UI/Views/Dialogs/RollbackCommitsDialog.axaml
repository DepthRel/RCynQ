<dialogs:DialogWindow xmlns="https://github.com/avaloniaui"
                     xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                     xmlns:loc="using:RCynQ.UI.Localization"
                     xmlns:dialogs="using:RCynQ.UI.Views.Dialogs"
                     xmlns:vm="using:RCynQ.UI.ViewModels.Dialogs"
                     xmlns:controls="using:RCynQ.UI.Controls"
                     x:Class="RCynQ.UI.Views.Dialogs.RollbackCommitsDialog"
                     x:DataType="vm:RollbackCommitsDialogViewModel"
                     Title="{loc:Loc Commits.RollbackWindowTitle}"
                     Width="600" SizeToContent="Height" CanResize="False"
                     WindowStartupLocation="CenterOwner">
  <StackPanel Margin="22" Spacing="14">
    <StackPanel Orientation="Horizontal" Spacing="10">
      <controls:IconView IconKey="Icon.Alert" Width="22" Height="22" Foreground="{StaticResource WarningBrush}" />
      <TextBlock Classes="page-title" Text="{loc:Loc Commits.RollbackTitle}" VerticalAlignment="Center" />
    </StackPanel>
    <TextBlock Classes="secondary" TextWrapping="Wrap" Text="{loc:Loc Commits.RollbackHint}" />

    <StackPanel Spacing="6">
      <TextBlock Classes="muted" Text="{loc:Loc Commits.RollbackExtent}" />
      <ComboBox HorizontalAlignment="Stretch" ItemsSource="{Binding Options}" SelectedItem="{Binding SelectedOption}">
        <ComboBox.ItemTemplate>
          <DataTemplate x:DataType="vm:RollbackTargetOption">
            <TextBlock Text="{Binding Label}" TextTrimming="CharacterEllipsis" />
          </DataTemplate>
        </ComboBox.ItemTemplate>
      </ComboBox>
    </StackPanel>

    <StackPanel Spacing="8">
      <TextBlock Classes="muted" Text="{loc:Loc Commits.RollbackMode}" />
      <RadioButton GroupName="mode" IsChecked="{Binding IsSoft}">
        <StackPanel Spacing="2">
          <TextBlock Text="{loc:Loc Commits.ModeSoft}" FontWeight="Medium" />
          <TextBlock Classes="muted" FontSize="12" TextWrapping="Wrap" Text="{loc:Loc Commits.RollbackSoftHint}" />
        </StackPanel>
      </RadioButton>
      <RadioButton GroupName="mode" IsChecked="{Binding IsMixed}">
        <StackPanel Spacing="2">
          <TextBlock Text="{loc:Loc Commits.ModeMixed}" FontWeight="Medium" />
          <TextBlock Classes="muted" FontSize="12" TextWrapping="Wrap" Text="{loc:Loc Commits.RollbackMixedHint}" />
        </StackPanel>
      </RadioButton>
      <RadioButton GroupName="mode" IsChecked="{Binding IsHard}">
        <StackPanel Spacing="2">
          <TextBlock Text="{loc:Loc Commits.ModeHard}" FontWeight="Medium" Foreground="{StaticResource DangerBrush}" />
          <TextBlock Classes="muted" FontSize="12" TextWrapping="Wrap" Text="{loc:Loc Commits.RollbackHardHint}" />
        </StackPanel>
      </RadioButton>
      <CheckBox Margin="28,0,0,0" IsVisible="{Binding IsHard}" IsChecked="{Binding IsHardConfirmed}">
        <TextBlock TextWrapping="Wrap" Text="{loc:Loc Commits.RollbackHardConfirm}" />
      </CheckBox>
    </StackPanel>

    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
      <Button Classes="outline" Content="{loc:Loc Common.Cancel}" IsCancel="True" Command="{Binding CancelCommand}" />
      <Button Classes="danger" Content="{loc:Loc Commits.RollBack}" Command="{Binding ConfirmCommand}" />
    </StackPanel>
  </StackPanel>
</dialogs:DialogWindow>
