<Project>

  <!--
    Shared build settings for every RCynQ project.
    GenerateDocumentationFile together with CS1591 in WarningsAsErrors makes a missing XML documentation comment
    a build error, which enforces the documentation rule from AGENTS.md.
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <WarningsAsErrors>$(WarningsAsErrors);CS1591;nullable</WarningsAsErrors>
    <NuGetAudit>false</NuGetAudit>
  </PropertyGroup>

  <!-- The identity of the product: the installer and the file properties of the executables read it from here. -->
  <PropertyGroup>
    <Product>RCynQ</Product>
    <Authors>DepthRel</Authors>
    <Version>0.1.0</Version>
  </PropertyGroup>

  <!--
    Test projects (Tests/*) are never packed. Their common packages are referenced here, so a test project file only
    lists project references.
  -->
  <PropertyGroup Condition="$(MSBuildProjectName.EndsWith('.Tests'))">
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <GenerateProgramFile>true</GenerateProgramFile>
  </PropertyGroup>

  <ItemGroup Condition="$(MSBuildProjectName.EndsWith('.Tests'))">
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio" PrivateAssets="all" IncludeAssets="runtime; build; native; contentfiles; analyzers; buildtransitive" />
    <PackageReference Include="NSubstitute" />
    <PackageReference Include="FluentAssertions" />
    <Using Include="Xunit" />
  </ItemGroup>

</Project>
