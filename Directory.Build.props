<Project>

  <!--
    Shared build settings for every RCynQ project.
    GenerateDocumentationFile together with CS1591 in WarningsAsErrors makes a missing XML documentation comment
    a build error, which enforces the documentation rule from AGENTS.md. EnforceCodeStyleInBuild runs the code style
    rules of .editorconfig (braces, namespaces, naming, unused usings) in every build, not only in the editor.
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <WarningsAsErrors>$(WarningsAsErrors);CS1591;nullable</WarningsAsErrors>
    <NuGetAudit>false</NuGetAudit>
  </PropertyGroup>

  <!-- The identity of the product: the installer and the file properties of the executables read it from here. -->
  <PropertyGroup>
    <Product>RCynQ</Product>
    <Authors>DepthRel</Authors>
    <Copyright>Copyright © RCynQ contributors. Licensed under GPL-3.0-or-later.</Copyright>
    <PackageLicenseExpression>GPL-3.0-or-later</PackageLicenseExpression>
    <Version>0.1.0</Version>
    <!-- The page of the project; the installer shows it as the link of the program in the list of installed apps. -->
    <PackageProjectUrl>https://depthrel.github.io/RCynQ/</PackageProjectUrl>
    <RepositoryUrl>https://github.com/DepthRel/RCynQ</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
  </PropertyGroup>

  <!--
    Test projects (Tests/*) are never packed. Their common packages are referenced here, so a test project file only
    lists project references.
  -->
  <PropertyGroup Condition="$(MSBuildProjectName.EndsWith('.Tests'))">
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <GenerateProgramFile>true</GenerateProgramFile>
  </PropertyGroup>

  <ItemGroup Condition="$(MSBuildProjectName.EndsWith('.Tests'))">
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio" PrivateAssets="all" IncludeAssets="runtime; build; native; contentfiles; analyzers; buildtransitive" />
    <PackageReference Include="NSubstitute" />
    <PackageReference Include="FluentAssertions" />
    <Using Include="Xunit" />
  </ItemGroup>

  <!--
    The localizers the tests hand to the code under test; a test names the language of its expectations. The
    convention tests reference no project of the product, so they go without them.
  -->
  <ItemGroup Condition="$(MSBuildProjectName.EndsWith('.Tests')) and '$(MSBuildProjectName)' != 'RCynQ.Conventions.Tests'">
    <Compile Include="$(MSBuildThisFileDirectory)Tests\Shared\TestTexts.cs" Link="Shared\TestTexts.cs" />
    <Using Include="RCynQ.Tests" />
  </ItemGroup>

</Project>
