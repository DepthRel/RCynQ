{
  // Each build task builds ONE project with "dotnet build <csproj>": MSBuild compiles only that project
  // and its ProjectReference closure, never the whole solution.
  "version": "2.0.0",
  "tasks": [
    {
      "label": "build: Service",
      "detail": "RCynQ.Service and its dependencies",
      "type": "process",
      "command": "dotnet",
      "args": [
        "build",
        "${workspaceFolder}/Sources/Apps/RCynQ.Service/RCynQ.Service.csproj",
        "-nologo",
        "/property:GenerateFullPaths=true",
        "/consoleloggerparameters:NoSummary;ForceNoAlign"
      ],
      "group": "build",
      "presentation": { "reveal": "silent", "panel": "dedicated", "clear": true },
      "problemMatcher": "$msCompile"
    },
    {
      "label": "build: UI",
      "detail": "RCynQ.UI (Avalonia) and its dependencies",
      "type": "process",
      "command": "dotnet",
      "args": [
        "build",
        "${workspaceFolder}/Sources/Apps/RCynQ.UI/RCynQ.UI.csproj",
        "-nologo",
        "/property:GenerateFullPaths=true",
        "/consoleloggerparameters:NoSummary;ForceNoAlign"
      ],
      "group": "build",
      "presentation": { "reveal": "silent", "panel": "dedicated", "clear": true },
      "problemMatcher": "$msCompile"
    },
    {
      "label": "build: CLI",
      "detail": "rcynq CLI and its dependencies",
      "type": "process",
      "command": "dotnet",
      "args": [
        "build",
        "${workspaceFolder}/Sources/Apps/RCynQ.Cli/RCynQ.Cli.csproj",
        "-nologo",
        "/property:GenerateFullPaths=true",
        "/consoleloggerparameters:NoSummary;ForceNoAlign"
      ],
      "group": "build",
      "presentation": { "reveal": "silent", "panel": "dedicated", "clear": true },
      "problemMatcher": "$msCompile"
    },
    {
      "label": "build: DbMigrator",
      "detail": "RCynQ.Dbs.SQLite.DbMigrator and its dependencies",
      "type": "process",
      "command": "dotnet",
      "args": [
        "build",
        "${workspaceFolder}/Sources/Database/RCynQ.Dbs.SQLite.DbMigrator/RCynQ.Dbs.SQLite.DbMigrator.csproj",
        "-nologo",
        "/property:GenerateFullPaths=true",
        "/consoleloggerparameters:NoSummary;ForceNoAlign"
      ],
      "group": "build",
      "presentation": { "reveal": "silent", "panel": "dedicated", "clear": true },
      "problemMatcher": "$msCompile"
    },
    {
      "label": "build: Service + UI",
      "detail": "Sequential build so both builds do not fight over shared outputs",
      "dependsOrder": "sequence",
      "dependsOn": [ "build: Service", "build: UI" ],
      "problemMatcher": []
    },
    {
      "label": "build: solution",
      "detail": "Full solution build (only when you really need it)",
      "type": "process",
      "command": "dotnet",
      "args": [
        "build",
        "${workspaceFolder}/RCynQ.slnx",
        "-nologo",
        "/property:GenerateFullPaths=true",
        "/consoleloggerparameters:NoSummary;ForceNoAlign"
      ],
      "group": { "kind": "build", "isDefault": true },
      "presentation": { "reveal": "silent", "panel": "dedicated", "clear": true },
      "problemMatcher": "$msCompile"
    },
    {
      "label": "test: all",
      "type": "process",
      "command": "dotnet",
      "args": [ "test", "${workspaceFolder}/RCynQ.slnx", "-nologo" ],
      "group": { "kind": "test", "isDefault": true },
      "presentation": { "reveal": "always", "panel": "dedicated", "clear": true },
      "problemMatcher": "$msCompile"
    }
  ]
}
